# Copy to .env (or export in your shell) and adjust for your machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scenario_analytics
LOG_LEVEL=INFO

# When set, POST /api/v1/imports requires the header "X-API-Key: <value>".
IMPORT_API_KEY=change-me

# Upload limit for CSV imports, in megabytes.
MAX_UPLOAD_MB=10
